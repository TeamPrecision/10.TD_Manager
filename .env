DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="td-manager-secret-change-in-production"
# AUTH_URL is auto-detected from the request host (trustHost: true).
# Override here only if redirects go to the wrong address, e.g.:
# AUTH_URL="http://192.168.40.111:3000"
#
# For dev access from other machines, list allowed IPs (comma-separated):
# ALLOWED_DEV_ORIGINS="192.168.40.111"
